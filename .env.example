# Local development: SQLite file relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"
PRISMA_SCHEMA="prisma/schema.prisma"

# Optional GitHub OAuth. Keep secrets in .env or your deployment secret store.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-secret"
GITHUB_ID=""
GITHUB_SECRET=""
NEXT_PUBLIC_AUTH_ENABLED="false"
# false = single-user local mode; true = APIs require a signed-in GitHub account.
AUTH_REQUIRED="false"
