// SQLite schema for local-first development. For production, generate with
// prisma/schema.postgres.prisma (see README and scripts/prisma.mjs).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Progresso isolado por usuário. Ausência de linha = NOT_STARTED.
model StudyProgress {
  id        String   @id @default(cuid())
  userId    String   @default("local")
  itemType  String
  itemId    String
  status    String   @default("NOT_STARTED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, itemType, itemId])
  @@index([userId, itemType, itemId])
}

/// Anotações de estudo isoladas por usuário.
model Note {
  id        String   @id @default(cuid())
  userId    String   @default("local")
  itemType  String
  itemId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, itemType, itemId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String   @default("local")
  itemType  String
  itemId    String
  createdAt DateTime @default(now())

  @@unique([userId, itemType, itemId])
  @@index([userId, createdAt])
}

model Highlight {
  id        String   @id @default(cuid())
  userId    String   @default("local")
  itemType  String
  itemId    String
  quote     String
  anchor    String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, itemType, itemId])
  @@index([userId, createdAt])
}

model ReadingHistory {
  id           String   @id @default(cuid())
  userId       String   @default("local")
  itemType     String
  itemId       String
  lastOpenedAt DateTime @default(now())

  @@unique([userId, itemType, itemId])
  @@index([userId, lastOpenedAt])
}

model FlashcardReview {
  id             String   @id @default(cuid())
  userId         String   @default("local")
  cardId         String
  repetitions    Int      @default(0)
  intervalDays   Int      @default(0)
  easeFactor     Float    @default(2.5)
  dueAt          DateTime @default(now())
  lastReviewedAt DateTime?
  updatedAt      DateTime @updatedAt

  @@unique([userId, cardId])
  @@index([userId, dueAt])
}

/// Perfil mínimo sincronizado no primeiro login GitHub; a identidade da sessão
/// vem do provedor OAuth, nunca de um id enviado pelo cliente.
model UserProfile {
  id        String   @id
  name      String?
  email     String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
